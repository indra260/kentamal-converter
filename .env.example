# Cloudflare Pages Functions — Production environment variables
# Salin ke Cloudflare Pages > Settings > Environment variables > Production

# WAJIB. Token dari https://cobalt.tools/account (menu API). Tanpa ini semua request ditolak 400.
COBALT_JWT=

# Opsional. Default: https://api.cobalt.tools
# Ganti kalau lu self-host Cobalt (https://github.com/imputnet/cobalt)
COBALT_API=https://api.cobalt.tools
